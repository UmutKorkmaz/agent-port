# AgentPort / DefterPort — TLS-terminating reverse proxy.
#
# Caddy is the ONLY service exposed to the LAN (ports 443 + 80). It terminates TLS
# and forwards plain HTTP to the `web` container on the internal compose network.
# The web app then proxies /api/platform/* and /api/ai/* to platform-api and
# ai-services via its Next.js rewrites, so those services never need a host port.
#
# DEFTERPORT_SITE_ADDRESS controls the site label:
#   * Default `https://localhost` (or any non-public hostname) => Caddy uses its
#     INTERNAL CA and serves a self-signed cert. Good for a LAN-only box. Browsers
#     will warn once; trust the Caddy root CA (printed at /data/caddy/pki) to silence it.
#   * Set it to a real FQDN that resolves publicly and Caddy will obtain a Let's
#     Encrypt cert automatically over port 80/443 (ACME HTTP-01). See note below.

{
	# Quieter logs; drop the admin endpoint surface on a locked-down box.
	admin off
	# For a LAN box with no public DNS, force the internal CA globally by
	# uncommenting the next line (otherwise per-site `tls internal` handles it).
	# local_certs
}

{$DEFTERPORT_SITE_ADDRESS:https://localhost} {
	# --- TLS ---
	# For a real public certificate, DELETE the `tls internal` line below and set
	# DEFTERPORT_SITE_ADDRESS to your FQDN (e.g. https://defterport.firma.local is
	# still internal; https://defterport.example.com gets a real ACME cert).
	# To install a cert you already own instead, replace this with:
	#   tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	# and mount the cert files into the caddy container.
	tls internal

	# Security headers for the LAN app surface.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode gzip zstd

	# Everything goes to the Next.js web container; it owns the API rewrites.
	reverse_proxy web:3000
}
