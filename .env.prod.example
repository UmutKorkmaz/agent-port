# AgentPort / AgentPort — PRODUCTION secrets template.
#
# Copy to .env.prod and fill EVERY value below. docker-compose.prod.yml uses the
# `${VAR:?...}` form, so it will FAIL FAST if any required secret is missing —
# there are no default-credential fallbacks in production.
#
#   cp .env.prod.example .env.prod
#   # then generate strong unique values (see hints) and paste them in
#
# Never commit .env.prod. It is gitignored. Keep an offline copy of these secrets
# in your password manager — losing AI_SERVICES_INTERNAL_TOKEN/DB creds locks you out.

# ---------------------------------------------------------------------------
# PostgreSQL (pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=agentport
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_db_password
POSTGRES_DB=agentport

# ---------------------------------------------------------------------------
# Redis (requirepass is mandatory in prod)
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
REDIS_PASSWORD=CHANGE_ME_strong_unique_redis_password

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USER=agentport
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
RABBITMQ_PASS=CHANGE_ME_strong_unique_rabbitmq_password

# ---------------------------------------------------------------------------
# MinIO (object storage). Root password must be >= 8 chars.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=agentport
# Generate: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_unique_minio_password
MINIO_BUCKET=agentport

# ---------------------------------------------------------------------------
# Internal service token. platform-api forwards it to ai-services on every call;
# ai-services rejects /v1/* requests that do not carry it. MUST be identical in
# both services (compose wires the same variable into both).
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32
AI_SERVICES_INTERNAL_TOKEN=CHANGE_ME_64_hex_char_internal_service_token

# ---------------------------------------------------------------------------
# Caddy / TLS site address.
#   * Leave as https://localhost (or an internal FQDN) for a LAN box: Caddy uses
#     its internal CA / self-signed cert.
#   * Set to a public FQDN to get an automatic Let's Encrypt certificate.
# ---------------------------------------------------------------------------
AGENTPORT_SITE_ADDRESS=https://localhost

# ---------------------------------------------------------------------------
# Ollama (the ONLY provider the sovereign runtime may reach). Off by default.
# Point this at an Ollama running on the host or LAN, then flip OLLAMA_ENABLED=true.
# Leave disabled to run pure local extractive RAG with no LLM provider at all.
# ---------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
