# AgentPort local development environment
# Copy this file to .env before running local infrastructure.

# Local service URLs
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5001
PLATFORM_API_URL=http://localhost:5001
AI_SERVICES_URL=http://localhost:5002
WEB_URL=http://127.0.0.1:3002
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:5001
NEXT_PUBLIC_AI_SERVICES_URL=http://localhost:5002

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=agentport
POSTGRES_PASSWORD=agentport
POSTGRES_DB=agentport
ConnectionStrings__DefaultConnection="Host=localhost;Port=55432;Database=agentport;Username=agentport;Password=agentport"

# Redis
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_CONNECTION=localhost:56379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=agentport
RABBITMQ_PASS=agentport
RABBITMQ_URL=amqp://agentport:agentport@localhost:5672/

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:59000
MINIO_API_PORT=59000
MINIO_CONSOLE_URL=http://localhost:59001
MINIO_CONSOLE_PORT=59001
MINIO_ROOT_USER=agentport
MINIO_ROOT_PASSWORD=agentportagentport
MINIO_ACCESS_KEY=agentport
MINIO_SECRET_KEY=agentportagentport
MINIO_BUCKET=agentport-phase1
MINIO_USE_SSL=false
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=agentport-phase1
S3_FORCE_PATH_STYLE=true

# AI service runtime
AI_SERVICES_HOST=0.0.0.0
AI_SERVICES_PORT=5002
PROVIDER_LIVE_CALLS=false

# Model provider toggles
MODEL_GATEWAY_ENABLED=false
DEFAULT_CHAT_PROVIDER=ollama
DEFAULT_EMBEDDING_PROVIDER=local
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
AZURE_OPENAI_ENABLED=false
GOOGLE_VERTEX_AI_ENABLED=false
OLLAMA_ENABLED=true
LOCAL_EMBEDDINGS_ENABLED=true

# Model provider endpoints and credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_PULL_PROFILE=core
OLLAMA_TIMEOUT_SECONDS=15
EMBEDDING_BACKEND=hash
LOCAL_EMBEDDING_MODEL=agentport-local-hash-64
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Payment provider toggles
AGENTPORT_FEE_FIXED_USD=0.10
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
STRIPE_ENABLED=false
IYZICO_ENABLED=false
PAYTR_ENABLED=false
PAPARA_ENABLED=false
SIPAY_ENABLED=false
PARAM_POS_ENABLED=false
HAVALE_EFT_FAST_ENABLED=false

# International payment placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Turkiye payment provider placeholders
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAPARA_API_KEY=
PAPARA_MERCHANT_ID=
SIPAY_MERCHANT_ID=
SIPAY_APP_KEY=
SIPAY_APP_SECRET=
PARAM_POS_CLIENT_CODE=
PARAM_POS_CLIENT_USERNAME=
PARAM_POS_CLIENT_PASSWORD=
PARAM_POS_GUID=
HAVALE_EFT_FAST_IBAN=
HAVALE_EFT_FAST_ACCOUNT_NAME=
